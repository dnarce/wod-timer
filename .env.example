# Tiempo real (obligatorio en Vercel). Cuenta gratis en https://ably.com
# Creá una API key con capacidades "subscribe", "publish" e "history" sobre el canal "wod:*"
ABLY_API_KEY=

# Secreto para firmar las llaves de control del QR. Cualquier texto largo y aleatorio:
#   openssl rand -base64 32
SESSION_SECRET=

# Contraseña de administrador para /sesiones (la pantalla de recepción). Elegí una larga:
#   openssl rand -base64 18
ADMIN_PASSWORD=

# Pantallas fijas (teles con link permanente): /carrodilla, /godoy_cruz-clase, etc.
# Minúsculas, números, "_" y "-", separadas por coma. Al cambiarla hay que volver a publicar.
PANTALLAS=
